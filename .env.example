# No provider keys are required. Compose uses its own internal database URLs.
APP_ENV=development
SEED_DEMO=true
# Optional providers; leave blank to use deterministic extraction and public feeds.
TINYFISH_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_IDS={}
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
REDDIT_ACCESS_TOKEN=
# Production requires a random INTERNAL_API_KEY shared by Next.js and FastAPI.
INTERNAL_API_KEY=
# Hosted gateway username is operator. Leave blank only for localhost.
HOSTED_OPERATOR_PASSWORD=
# Optional locally provisioned weights; normal demo startup never downloads models.
NLP_MODE=rules
GRAPH_BACKEND=networkx
# Local native demo defaults: SQLite, in-process async jobs, localhost:8000.
# DATABASE_URL=sqlite+aiosqlite:///./suraksha.db
# TASK_MODE=local
# API_BASE_URL=http://127.0.0.1:8000
# Free hosted snapshot mode (set both only for the Vercel demo).
# HOSTED_DEMO=true
# NEXT_PUBLIC_HOSTED_DEMO=true
